{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON Editor",
  "version": "0.2.0",
  "identifier": "zhouc.jsoneditor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSON Editor",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
