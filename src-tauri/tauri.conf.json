{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "json_editor",
  "version": "0.1.0",
  "identifier": "zhouc.jsoneditor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSON Editor",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "theme": "Light",
        "decorations": false,
        "backgroundColor": "#f6f7f9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
